# Copy this to .env.local for local development.
# Get these from Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
#
# Device OAuth client (type: TVs and Limited Input devices) - the only Google
# client VibeComics needs; "Connect with Google Drive" uses it for everyone,
# human or AI assistant.
GOOGLE_DEVICE_CLIENT_ID=
GOOGLE_DEVICE_CLIENT_SECRET=
