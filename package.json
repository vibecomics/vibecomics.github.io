{
  "name": "vibecomics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/extract-docs.mjs && node scripts/build-cli.mjs && vite",
    "build": "node scripts/extract-docs.mjs && node scripts/build-cli.mjs && node scripts/build-http-storage.mjs && tsc -b && vite build && node scripts/build-meta.mjs",
    "lint": "oxlint",
    "test": "node scripts/extract-docs.mjs && node scripts/run-tests.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "cli": "node scripts/extract-docs.mjs && node scripts/build-cli.mjs && node public/vibecomics.mjs",
    "http-storage": "node http-storage/start.ts"
  },
  "lint-staged": {
    "*.{js,ts,json,css,html,md}": "prettier --write"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
